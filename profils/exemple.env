# Réglages propres à un CV. Copier ce fichier en profils/<nom>.env (même nom que
# le service dans docker-compose.yml) et ne garder que les lignes utiles.
# Toute variable de .env peut être redéfinie ici ; les autres sont héritées de .env.
# Une ligne vide (ex. TARGET_COMPANIES=) désactive le réglage pour ce CV.

# Destinataire(s) du mail pour ce CV
MAIL_TO=destinataire@example.com

# Recherche
LOCATION_CITY=Bordeaux
LOCATION_RADIUS_KM=30
CANDIDATE_PREFERENCES=CDI uniquement
TARGET_COMPANIES=
EXCLUDE_KEYWORDS=stage,alternance

# Décaler l'heure d'envoi de quelques minutes par CV évite de solliciter les sites en même temps
RUN_AT=21:15

# Le quota SerpApi (250 recherches/mois en gratuit) est partagé entre tous les CV :
# avec 2 CV, 4 recherches chacun par jour = 248/mois
GOOGLEJOBS_SEARCHES_PER_RUN=4

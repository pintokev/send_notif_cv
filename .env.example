# ─── Claude (obligatoire) ─────────────────────────────────────────────
# Clé API sur https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-usr-.....
# Modèle utilisé pour analyser le CV et noter les offres
CLAUDE_MODEL=claude-opus-5-5

# ─── CV et profil ─────────────────────────────────────────────────────
# Le CV doit être placé dans ./data/<profil>/cv.pdf (monté sur /data dans le conteneur)
CV_PATH=/data/cv.pdf
# Optionnel : remplace les requêtes de recherche déduites du CV (séparées par des virgules)
SEARCH_QUERIES=
# Optionnel : mots-clés ajoutés à ceux déduits du CV pour le préfiltre
EXTRA_KEYWORDS=
# Optionnel : offres ignorées si leur intitulé contient un de ces mots
EXCLUDE_KEYWORDS=stage,alternance
# Optionnel : tes critères en langage naturel, pris en compte par Claude dans la note
CANDIDATE_PREFERENCES=CDI de préférence, pas de poste de commercial
# Nombre maximum de requêtes de recherche par source
MAX_QUERIES=5

# ─── Localisation ─────────────────────────────────────────────────────
LOCATION_CITY=Lyon
LOCATION_RADIUS_KM=30
# Inclure les offres 100 % télétravail (Remotive, RemoteOK, Jobicy, WTTJ remote)
INCLUDE_REMOTE=true

# ─── Entreprises cibles ───────────────────────────────────────────────
# Claude cherche chaque jour sur leur site carrière (recherche web, payante :
# ~1 centime par recherche + le texte lu). Leurs offres trouvées par les autres
# sources sont aussi prioritaires et marquées d'une ⭐ dans le mail.
TARGET_COMPANIES=
# Nombre maximum de recherches web par entreprise et par exécution
CAREER_SEARCHES_PER_COMPANY=3

# ─── Recherche et sélection ───────────────────────────────────────────
SOURCES=francetravail,adzuna,wttj,googlejobs,careersites,remotive,remoteok,jobicy
# Ancienneté maximale des offres (jours)
MAX_DAYS_OLD=2
# Idem pour les sources à faible volume ou aux dates imprécises
# (sites télétravail, Google Jobs, sites carrière)
EXTENDED_MAX_DAYS_OLD=7
# Nombre d'offres envoyées à Claude après le préfiltre
PREFILTER_TOP_K=60
# Score minimum (0-100) pour figurer dans le mail
MIN_SCORE=60
# Nombre maximum d'offres dans le mail
MAX_RESULTS=15

# ─── Identifiants des sources (une source sans identifiants est ignorée) ──
# France Travail : https://francetravail.io → créer une application → API « Offres d'emploi v2 »
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=
# Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Google Jobs (LinkedIn, Indeed, APEC, HelloWork, sites carrière…) via SerpApi : https://serpapi.com
# Offre gratuite : 250 recherches/mois. Le solde est vérifié avant chaque exécution.
SERPAPI_API_KEY=
# Recherches par exécution (6 x 31 jours = 186/mois, il reste de la marge pour les tests manuels)
GOOGLEJOBS_SEARCHES_PER_RUN=6

# ─── Email (SMTP) ─────────────────────────────────────────────────────
# Gmail : smtp.gmail.com / 587 / starttls + mot de passe d'application
# OVH   : ssl0.ovh.net / 465 / ssl
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=toi@gmail.com
SMTP_PASSWORD=
MAIL_FROM=toi@gmail.com
# Un ou plusieurs destinataires séparés par des virgules
MAIL_TO=toi@gmail.com
# Envoyer un mail même s'il n'y a aucune offre pertinente
SEND_IF_EMPTY=true
# Recevoir un mail si l'exécution échoue
NOTIFY_ERRORS=true

# ─── Planification ────────────────────────────────────────────────────
RUN_AT=21:00
TZ=Europe/Paris
# Lancer aussi une recherche au démarrage du conteneur
RUN_ON_START=false
